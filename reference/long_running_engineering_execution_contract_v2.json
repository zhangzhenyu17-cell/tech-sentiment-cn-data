{
  "schema_version": "long-running-engineering-execution-contract-v2",
  "status": "FROZEN_ENGINEERING_DEFAULT",
  "effective_date": "2026-09-21",
  "supersedes": "reference/long_running_engineering_execution_contract_v1.json",
  "purpose": "Reduce recomputation blast radius, surface deterministic failures earlier, make long-run progress observable, and preserve exact evidence/PIT/research/production/trading boundaries.",
  "scope": {
    "long_running_github_actions": true,
    "public_data_materialization": true,
    "engineering_repairs": true,
    "changes_evidence_eligibility": false,
    "changes_pit_no_lookahead": false,
    "changes_model_threshold_signal": false,
    "changes_production_or_trading_authority": false
  },
  "defaults": {
    "manual_only": true,
    "automatic_trigger_requires_explicit_allowlist": true,
    "deterministic_partitioning": true,
    "bounded_parallelism": true,
    "timeout_is_per_job_safety_ceiling": true,
    "diagnostics_before_qualification_gate": true,
    "durable_progress_before_qualification_gate": true,
    "immutable_unit_publish_after_gate": true,
    "completed_unit_reuse_precedes_recomputation": true,
    "query_cache_independent_from_document_progress": true,
    "actual_cli_entrypoint_regression_test_required": true,
    "latest_pr_head_is_authoritative_ci": true,
    "rerun_failed_jobs_before_full_ci_when_appropriate": true,
    "cache_visibility_scope_must_be_preflighted": true,
    "inline_restore_resolver_execution_test_required": true,
    "resume_effectiveness_requires_runtime_counters": true,
    "post_success_producer_identity_freeze_required": true,
    "stage_success_distinct_from_pipeline_qualification": true,
    "three_layer_preflight_required_after_data_path_change": true,
    "representative_production_execution_classes_required": true,
    "content_class_checked_before_semantic_parser": true,
    "repeated_deterministic_failure_circuit_breaker_required": true,
    "progress_heartbeat_required_for_long_steps": true,
    "throughput_eta_refresh_required": true,
    "phase_isolation_required": true
  },
  "decomposition": {
    "estimated_wall_clock_minutes_trigger": 30,
    "independent_network_or_document_items_trigger": 200,
    "target_max_recomputation_loss_minutes": 15,
    "preferred_work_units_min": 8,
    "preferred_work_units_max": 16,
    "default_provider_max_parallel": 4,
    "provider_concurrency_must_remain_bounded": true,
    "six_hour_monolith_requires_explicit_run_plan_exception": true,
    "p95_unit_duration_should_be_below_half_timeout": true,
    "missing_unit_never_valid_empty": true
  },
  "preflight": {
    "layer_1_code_and_contract": true,
    "layer_2_live_provider_transport_and_content": true,
    "layer_3_representative_production_execution_class": true,
    "reuse_exact_production_selector": true,
    "reuse_exact_transport_stack": true,
    "provider_family_coverage_required": true,
    "gzip_decoded_before_file_parser": true,
    "html_or_waf_classified_as_transport_failure": true,
    "redirect_must_remain_same_provider_family": true,
    "document_magic_checked_before_semantic_parser": true,
    "synthetic_test_alone_insufficient_after_hosted_runner_transport_change": true
  },
  "circuit_breaker": {
    "required_for_repeated_hard_failures": true,
    "normalized_failure_signature_required": true,
    "provider_or_execution_class_scope_required": true,
    "threshold_frozen_in_run_plan": true,
    "does_not_convert_failure_to_empty_valid_data": true,
    "diagnostics_preserved_before_stop": true,
    "checkpoints_preserved_before_stop_when_possible": true,
    "unknown_or_data_insufficient_not_counted_as_transport_failure": true,
    "qualification_remains_fail_closed": true
  },
  "progress_heartbeat": {
    "required_if_step_expected_minutes_gte": 10,
    "max_silence_minutes": 10,
    "record_total_planned": true,
    "record_resumed_and_executed": true,
    "record_success_unclassified_hard_error": true,
    "record_elapsed_and_throughput": true,
    "record_eta_range": true,
    "record_checkpoint_watermark": true
  },
  "phase_isolation": [
    "PREFLIGHT",
    "TRANSPORT_OR_SOURCE_INDEX",
    "DOCUMENT_OR_ITEM_MATERIALIZATION",
    "QUALIFICATION_GATE",
    "IMMUTABLE_PUBLICATION",
    "GROUP_ASSEMBLY_OR_FINALIZER",
    "PRIVATE_INTAKE_WHEN_APPLICABLE"
  ],
  "restore_precedence": [
    "IMMUTABLE_COMPLETED_WORK_UNIT",
    "CURRENT_SEMANTIC_DURABLE_PROGRESS",
    "EXACT_AUDITED_COMPATIBILITY_BRIDGE",
    "LEGACY_QUERY_INDEX_AND_DOCUMENT_CACHE",
    "PROVIDER_RECOMPUTATION"
  ],
  "cancellation": {
    "inspect_completed_immutable_units": true,
    "inspect_active_progress_save_state": true,
    "prove_cancel_save_behavior": true,
    "verify_post_cancel_save_outcomes": true,
    "cancel_for_deterministic_global_blocker": true,
    "cancel_for_material_fixed_performance_regression_when_progress_safe": true,
    "do_not_cancel_only_for_slowness_when_progress_unsafe": true,
    "running_sha_is_immutable": true
  },
  "observability": {
    "record_unit_identity": true,
    "record_source_and_scope": true,
    "record_query_resume_and_execute_counts": true,
    "record_document_resume_and_execute_counts": true,
    "record_parser_upgrade_counts": true,
    "record_soft_and_hard_failures": true,
    "record_failure_signature": true,
    "record_transport_method": true,
    "record_canonical_and_retrieval_url": true,
    "record_transport_and_document_hash": true,
    "record_readiness": true,
    "record_checkpoint_save_result": true,
    "record_immutable_publish_result": true,
    "record_cache_source_run_and_ref": true,
    "record_restore_layer_selected": true,
    "record_execution_class": true,
    "record_wall_clock_estimate_source": true
  },
  "failure_classes": [
    "DETERMINISTIC_CODE_OR_ORCHESTRATION",
    "PROVIDER_TRANSPORT_OR_PROTOCOL",
    "CONTENT_ENCODING_OR_CONTENT_CLASS",
    "PARSER_OR_LAYOUT",
    "QUALIFICATION_BLOCKER",
    "PERFORMANCE_REGRESSION",
    "PUBLICATION_OR_AGGREGATION",
    "PRIVATE_INTAKE_OR_PROVENANCE"
  ],
  "failure_isolation_ladder": [
    "TRANSPORT",
    "DOCUMENT_DECODE",
    "PARSER",
    "MATERIALIZATION",
    "QUALIFICATION",
    "PUBLICATION",
    "AGGREGATE_OR_FINALIZER",
    "PRIVATE_INTAKE"
  ],
  "compatibility_bridge": {
    "exceptional_only": true,
    "source_run_id_required": true,
    "source_run_attempt_required": true,
    "source_branch_or_ref_required": true,
    "cache_visibility_relationship_required": true,
    "source_commit_required": true,
    "old_semantic_fingerprint_required": true,
    "exact_window_required": true,
    "exact_cache_or_bundle_identity_required": true,
    "compatibility_reason_required": true,
    "unchanged_invariants_required": true,
    "fail_closed_on_mismatch": true,
    "formal_evidence_handoff": false,
    "qualification_granted": false,
    "removal_condition_required": true
  },
  "acceptance": {
    "all_required_units_accounted": true,
    "successful_reusable_units_immutable": true,
    "aggregate_completeness_verified": true,
    "relevant_ci_green": true,
    "diagnostics_retained": true,
    "lineage_recorded": true,
    "unauthorized_boundary_change": false,
    "stop_when_acceptance_met": true,
    "stage_acceptance_does_not_equal_pipeline_qualification": true
  }
}
